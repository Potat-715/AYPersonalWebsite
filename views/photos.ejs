<!DOCTYPE html>
<html lang="en">
<head>
    <title>Andy Yang - Photos</title>
    <meta name="description" content="My Portfolio" />
    <base href="/">

    <%- include('partials/head.ejs') %>
    <link href="css/main.css" rel="stylesheet">
</head>

<body>
    <%- include('partials/navbar.ejs') %>
    <div class="container-fluid">
        <% if (photoSections && photoSections.length) { %>
            <% photoSections.forEach(function(section){ %>
                <div class="photo-section" id="<%= section.key %>">
                    <h2 class="photo-section-title"><%= section.label %></h2>
                    <% if (section.photos && section.photos.length) { %>
                        <div class="photo-gallery">
                            <% section.photos.forEach(function(p, i){ %>
                                <img src="<%= p.src %>" data-fullsrc="<%= p.src %>" data-settings="<%= p.settings %>" class="photo-thumb" alt="<%= section.key %>-photo-<%= i %>" />
                            <% }); %>
                        </div>
                    <% } else { %>
                        <p class="photo-section-empty">No photos yet.</p>
                    <% } %>
                </div>
            <% }); %>
        <% } %>

        <!-- Photo Modal -->
        <div class="modal fade" id="photoModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                <div class="modal-content bg-transparent border-0">
                    <div class="modal-body p-0 position-relative">
                        <img id="photoModalImg" src="" class="img-fluid" alt="Full size photo"> 
                        <div id="photoCaption" class="text-center text-white mt-2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <%- include('partials/footer.ejs') %>
    <%- include('partials/scripts.ejs') %>

    <script>
        $(function(){
            // (No client-side shuffle — images are rendered server-side)
            $(document).on('click', '.photo-thumb', function(){
                var src = $(this).data('fullsrc') || $(this).attr('src');
                var settings = $(this).data('settings') || '';
                $('#photoModalImg').attr('src', src);
                $('#photoCaption').text(settings);
                $('#photoModal').modal('show');
            });

            // Prevent clicks on the image itself from closing the modal
            $(document).on('click', '#photoModalImg', function(e){
                e.stopPropagation();
            });

            // Clicking anywhere inside the modal (but outside the image)
            // will close it. Backdrop clicks already close by Bootstrap.
            $(document).on('click', '#photoModal', function(e){
                // if the click target is the modal dialog itself or any element
                // other than the image, hide the modal
                if (!$(e.target).is('#photoModalImg')) {
                    $('#photoModal').modal('hide');
                }
            });

            $('#photoModal').on('hidden.bs.modal', function(){
                $('#photoModalImg').attr('src','');
                $('#photoCaption').text('');
            });
        });
    </script>
</body>

</html>