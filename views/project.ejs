<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= name %> - Andy Yang</title>
    <meta name="description" content="Andy Yang's project portfolio" />
    <%- include('partials/head.ejs') %>
    <link href="css/project.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/navbar.ejs') %>
    <main class="container py-5">
        <h1><%= name %></h1>
        <p class="project-meta"><%= category %> | <%= dateRange %></p>
        <div class="markdown-body"><%- description %></div>

        <% if (typeof link !== 'undefined' && link && /\.pdf($|[?#])/i.test(link)) { %>
            <div class="pdf-viewer-wrapper">
                <object data="<%= link %>" type="application/pdf" class="pdf-viewer">
                    <p>Unable to display the PDF in the browser. <a href="<%= link %>" target="_blank" rel="noopener noreferrer">Open the report in a new tab</a>.</p>
                </object>
            </div>
        <% } %>
    </main>
    <%- include('partials/footer.ejs') %>
    <%- include('partials/scripts.ejs') %>
</body>
</html>